<?xml version="1.0" encoding="utf-8"?>
<!-- Location data must never leave the device via cloud/device-to-device transfer (docs/07_security.md) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
