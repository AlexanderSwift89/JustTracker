<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent is required by AppCompatActivity (per-app language); bars are drawn edge-to-edge by Compose. -->
    <style name="Theme.JustTracker" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: system splash (Android 12+ look, back-ported), then hands over to Theme.JustTracker. -->
    <style name="Theme.JustTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JustTracker</item>
    </style>
</resources>
