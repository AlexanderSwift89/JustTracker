# Formatting the IDE applies to new and edited lines (docs/01_work_plan.md §5). Existing code is not reformatted in bulk.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Kotlin official code style; long lines are allowed where wrapping would hurt reading (KDoc, test literals).
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
